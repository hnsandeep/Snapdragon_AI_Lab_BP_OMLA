# ============================================================
# .env.example — Offline Multilingual Lecture Assistant
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit real secrets.
# ============================================================


# ── AI Hub  🔑 REQUIRED for compile / profile jobs ───────────────────────────
# Get your token: https://aihub.qualcomm.com → Account → API Token
QAI_HUB_API_TOKEN=your_token_here

# Target device name (run `qai-hub list-devices` to see all options)
QAI_HUB_DEVICE=Snapdragon X Elite CRD


# ── Language defaults ─────────────────────────────────────────────────────────
# SOURCE_LANGUAGE : ISO 639-1 code used by the Whisper / OPUS-MT backends
# TARGET_LANGUAGE : ISO 639-3 + script tag used by IndicTrans2 / NLLB-200
#
# Common target tags:
#   hin_Deva  Hindi        kan_Knda  Kannada      tam_Taml  Tamil
#   tel_Telu  Telugu       ben_Beng  Bengali      mar_Deva  Marathi
#   guj_Gujr  Gujarati     mal_Mlym  Malayalam    urd_Arab  Urdu
#   deu_Latn  German       fra_Latn  French       spa_Latn  Spanish
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=hin_Deva


# ── Whisper ONNX model paths ──────────────────────────────────────────────────
# Populated after: python scripts/export_whisper.py
#
# Use the *_compiled.onnx variants for on-device NPU inference.
# The plain WhisperEncoder.onnx / WhisperDecoder.onnx work on CPU EP.
WHISPER_ENCODER_ONNX=models/WhisperEncoder_compiled.onnx
WHISPER_DECODER_ONNX=models/WhisperDecoder_compiled.onnx


# ── Translation model selection ───────────────────────────────────────────────
# TRANSLATE_MODEL : which backend the Translator class loads by default
#   indictrans2   — best for all 22 scheduled Indic languages (recommended)
#   nllb200       — 200-language coverage (use for non-Indic targets)
#   transformers  — Helsinki-NLP OPUS-MT, no ONNX files required (dev/test)
TRANSLATE_MODEL=indictrans2


# ── IndicTrans2 ONNX paths ────────────────────────────────────────────────────
# Populated after: python scripts/export_translation.py --model indictrans2
#
# int8/ sub-folder = INT8 dynamic-quantized (472 MB, recommended for NPU)
# Remove "int8/" to use the FP32 exports (1.87 GB)
IT2_ENCODER_ONNX=models/indictrans2/int8/encoder_model_compiled.onnx
IT2_DECODER_ONNX=models/indictrans2/int8/decoder_model_compiled.onnx


# ── NLLB-200 ONNX paths ───────────────────────────────────────────────────────
# Populated after: python scripts/export_translation.py --model nllb200
NLLB_ENCODER_ONNX=models/nllb200/int8/encoder_model_compiled.onnx
NLLB_DECODER_ONNX=models/nllb200/int8/decoder_model_compiled.onnx


# ── Summarization ONNX paths ──────────────────────────────────────────────────
# Populated after: python scripts/export_summarizer.py --model bart
#   bart  → facebook/bart-large-cnn            (English)
#   mt5   → csebuetnlp/mT5_multilingual_XLSum  (45 languages)
SUMMARY_MODEL=bart
SUMMARY_ENCODER_ONNX=models/bart/int8/encoder_model_compiled.onnx
SUMMARY_DECODER_ONNX=models/bart/int8/decoder_model_compiled.onnx
